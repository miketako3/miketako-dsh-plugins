{
  "name": "dsh-plugin-durable-exec",
  "version": "0.1.0",
  "description": "Durable tool execution for the DeepSeek Harness: idempotency ledger, crash checkpoints, retries, circuit breakers, and auto-resume.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "durable-execution",
    "idempotency",
    "checkpoint",
    "long-horizon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miketako3/miketako-dsh-plugins.git",
    "directory": "plugins/durable-exec"
  },
  "homepage": "https://github.com/miketako3/miketako-dsh-plugins/tree/main/plugins/durable-exec",
  "bugs": {
    "url": "https://github.com/miketako3/miketako-dsh-plugins/issues"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
